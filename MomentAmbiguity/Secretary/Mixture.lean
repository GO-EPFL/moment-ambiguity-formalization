import MomentAmbiguity.Secretary.IndependentUpper

/-!
# Uniform mixtures in a fixed full moment class

Mixing finitely many laws in the same full moment class preserves that class.  Independent
samples from the mixture can equivalently be generated by independent uniform component
labels, followed by independent samples from the selected laws.  The final theorem transfers
secretary success to the finite grid carried by the designated atoms of the components.
-/

open scoped BigOperators ENNReal NNReal

namespace MomentAmbiguity

open MeasureTheory Set

noncomputable section

/-- The equally weighted mixture of a nonempty finite family of laws. -/
def uniformMixture {k : ℕ} (laws : Fin k → Distribution) (hk : 1 ≤ k) : Distribution :=
  ⟨(k : ℝ≥0∞)⁻¹ • ∑ j, (laws j : Measure ℝ≥0), by
    constructor
    simp only [Measure.smul_apply, Measure.finsetSum_apply, measure_univ,
      Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one,
      smul_eq_mul]
    exact ENNReal.inv_mul_cancel (by exact_mod_cast (by omega : k ≠ 0)) (by simp)⟩

@[simp]
theorem uniformMixture_toMeasure {k : ℕ} (laws : Fin k → Distribution) (hk : 1 ≤ k) :
    (uniformMixture laws hk : Measure ℝ≥0) =
      (k : ℝ≥0∞)⁻¹ • ∑ j, (laws j : Measure ℝ≥0) := rfl

theorem uniformMixture_integrable {k : ℕ} (laws : Fin k → Distribution) (hk : 1 ≤ k)
    {f : ℝ≥0 → ℝ} (hf : ∀ j, Integrable f (laws j : Measure ℝ≥0)) :
    Integrable f (uniformMixture laws hk : Measure ℝ≥0) := by
  rw [uniformMixture_toMeasure]
  exact (integrable_finsetSum_measure.mpr fun j _ ↦ hf j).smul_measure
    (by simp [show k ≠ 0 by omega])

theorem uniformMixture_integral {k : ℕ} (laws : Fin k → Distribution) (hk : 1 ≤ k)
    {f : ℝ≥0 → ℝ} (hf : ∀ j, Integrable f (laws j : Measure ℝ≥0)) :
    (∫ x, f x ∂(uniformMixture laws hk : Measure ℝ≥0)) =
      (k : ℝ)⁻¹ * ∑ j, ∫ x, f x ∂(laws j : Measure ℝ≥0) := by
  rw [uniformMixture_toMeasure, integral_smul_measure,
    integral_finsetSum_measure (fun j _ ↦ hf j)]
  simp

theorem uniformMixture_mem_momentClass {k : ℕ} (laws : Fin k → Distribution)
    (hk : 1 ≤ k) {seq : MomentSequence} (hlaws : ∀ j, laws j ∈ momentClass seq) :
    uniformMixture laws hk ∈ momentClass seq := by
  constructor
  · intro r
    exact uniformMixture_integrable laws hk (fun j ↦ (hlaws j).1 r)
  · funext r
    change (∫ x, momentIntegrand r x ∂(uniformMixture laws hk : Measure ℝ≥0)) = seq r
    rw [uniformMixture_integral laws hk (fun j ↦ (hlaws j).1 r)]
    have hmoment : ∀ j, (∫ x, momentIntegrand r x ∂(laws j : Measure ℝ≥0)) = seq r :=
      fun j ↦ congrFun (hlaws j).2 r
    simp_rw [hmoment]
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    have hk0 : (k : ℝ) ≠ 0 := by exact_mod_cast (by omega : k ≠ 0)
    rw [← mul_assoc, inv_mul_cancel₀ hk0, one_mul]

/-- The product mixture is the uniform mixture over all independent component assignments. -/
theorem independentValues_uniformMixture {m k : ℕ} (laws : Fin k → Distribution)
    (hk : 1 ≤ k) :
    (independentValues (fun _ : Fin m ↦ uniformMixture laws hk) : Measure (ProphetPath m)) =
      (Fintype.card (Fin m → Fin k) : ℝ≥0∞)⁻¹ •
        ∑ a : Fin m → Fin k, (independentValues (fun i ↦ laws (a i)) : Measure _) := by
  change Measure.pi (fun _ : Fin m ↦ (uniformMixture laws hk : Measure ℝ≥0)) = _
  apply Measure.pi_eq
  intro s hs
  simp only [Measure.smul_apply, Measure.finsetSum_apply, smul_eq_mul,
    independentValues, ProbabilityMeasure.toMeasure_pi, Measure.pi_pi,
    uniformMixture_toMeasure]
  rw [Finset.prod_mul_distrib, Fintype.prod_sum]
  simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin,
    Fintype.card_fun, Nat.cast_pow, ENNReal.inv_pow]


/-- Random arrival preserves the component-assignment decomposition. -/
theorem secretaryPathLaw_uniformMixture {m k : ℕ} (laws : Fin k → Distribution)
    (hk : 1 ≤ k) :
    (secretaryPathLaw (fun _ : Fin m ↦ uniformMixture laws hk) : Measure (SecretaryPath m)) =
      (Fintype.card (Fin m → Fin k) : ℝ≥0∞)⁻¹ •
        ∑ a : Fin m → Fin k, (secretaryPathLaw (fun i ↦ laws (a i)) : Measure _) := by
  haveI : ∀ a : Fin m → Fin k,
      SFinite (independentValues (fun i ↦ laws (a i)) : Measure (ProphetPath m)) :=
    fun a ↦ inferInstance
  simp only [secretaryPathLaw, secretaryExperiment, ProbabilityMeasure.toMeasure_prod]
  rw [independentValues_uniformMixture laws hk, Measure.prod_smul_right,
    ← Measure.sum_fintype, Measure.prod_sum_right, Measure.sum_fintype]

/-- Secretary success under i.i.d. mixture values is the uniform average over component
assignments.  The disclosed moment profile is held fixed throughout. -/
theorem secretarySuccessProbabilityAtProfile_uniformMixture {m k : ℕ}
    (policy : SecretaryPolicy m) (profile : MomentProfile m)
    (laws : Fin k → Distribution) (hk : 1 ≤ k) :
    secretarySuccessProbabilityAtProfile policy profile
        (fun _ : Fin m ↦ uniformMixture laws hk) =
      (Fintype.card (Fin m → Fin k) : ℝ)⁻¹ *
        ∑ a : Fin m → Fin k,
          secretarySuccessProbabilityAtProfile policy profile (fun i ↦ laws (a i)) := by
  have hint : ∀ a : Fin m → Fin k,
      Integrable (secretaryConditionalSuccess policy profile)
        (secretaryPathLaw (fun i ↦ laws (a i)) : Measure _) := by
    intro a
    apply Integrable.of_bound
      (stronglyMeasurable_secretaryConditionalSuccess policy profile).aestronglyMeasurable 1
    exact Filter.Eventually.of_forall fun path ↦ by
      rw [Real.norm_eq_abs,
        abs_of_nonneg (secretaryConditionalSuccess_nonneg policy profile path)]
      exact secretaryConditionalSuccess_le_one policy profile path
  change (∫ path, secretaryConditionalSuccess policy profile path
      ∂(secretaryPathLaw (fun _ : Fin m ↦ uniformMixture laws hk) : Measure _)) = _
  rw [secretaryPathLaw_uniformMixture laws hk, integral_smul_measure,
    integral_finsetSum_measure (fun a _ ↦ hint a)]
  simp only [ENNReal.toReal_inv, ENNReal.toReal_natCast, smul_eq_mul]
  rfl

/-- If each component mostly sits at its designated grid point, the i.i.d. mixture loses at
most `m * η` relative to the average deterministic-grid success probability. -/
theorem secretarySuccessProbabilityAtProfile_uniformMixture_le_grid {m k : ℕ}
    (policy : SecretaryPolicy m) (profile : MomentProfile m)
    (laws : Fin k → Distribution) (hk : 1 ≤ k) (grid : Fin k → ℝ≥0) (η : ℝ)
    (hatom : ∀ j, 1 - η ≤ ((laws j : Measure ℝ≥0) {grid j}).toReal) :
    secretarySuccessProbabilityAtProfile policy profile
        (fun _ : Fin m ↦ uniformMixture laws hk) ≤
      (Fintype.card (Fin m → Fin k) : ℝ)⁻¹ *
        ∑ a : Fin m → Fin k,
          secretarySuccessProbabilityAtProfile policy profile
            (fun i ↦ deterministicLaw (grid (a i))) + m * η := by
  have hcard : (Fintype.card (Fin m → Fin k) : ℝ) ≠ 0 := by
    simp only [Fintype.card_fun, Fintype.card_fin, Nat.cast_pow]
    exact pow_ne_zero _ (by exact_mod_cast (by omega : k ≠ 0))
  have hpoint : ∀ a : Fin m → Fin k,
      secretarySuccessProbabilityAtProfile policy profile (fun i ↦ laws (a i)) ≤
        secretarySuccessProbabilityAtProfile policy profile
          (fun i ↦ deterministicLaw (grid (a i))) + m * η := by
    intro a
    have htransfer := secretarySuccessProbabilityAtProfile_le_deterministic_add_failure
      policy profile (fun i ↦ laws (a i)) (fun i ↦ grid (a i))
    have hatoms := independentValues_firstAtom_unionBound
      (fun i ↦ laws (a i)) (fun i ↦ grid (a i)) η (fun i ↦ hatom (a i))
    linarith
  rw [secretarySuccessProbabilityAtProfile_uniformMixture policy profile laws hk]
  calc
    _ ≤ (Fintype.card (Fin m → Fin k) : ℝ)⁻¹ *
        ∑ a : Fin m → Fin k,
          (secretarySuccessProbabilityAtProfile policy profile
            (fun i ↦ deterministicLaw (grid (a i))) + m * η) :=
      mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun a _ ↦ hpoint a) (by positivity)
    _ = _ := by
      rw [Finset.sum_add_distrib, mul_add]
      simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      rw [← mul_assoc, inv_mul_cancel₀ hcard, one_mul]

end

end MomentAmbiguity
